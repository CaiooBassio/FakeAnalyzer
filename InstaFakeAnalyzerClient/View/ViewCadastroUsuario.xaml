<Window
    x:Class="InstaFakeAnalyzerClient.View.ViewCadastroUsuario"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cadastro de Usuário"
    Width="580"
    Height="850"
    Background="#F4F0E7"
    FontFamily="Georgia"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Estilo dos campos de texto -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#FAF9F6"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo dos rótulos -->
        <Style x:Key="RotuloCampo" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#222222"/>
        </Style>

        <!-- Botão principal -->
        <Style x:Key="BotaoPreto" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid ClipToBounds="True">

        <!-- Nome do sistema -->
        <TextBlock
            Margin="35,22,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="26"
            FontWeight="Bold"
            Text="InstaFake Analyzer"/>

        <!-- Decoração lateral -->
        <Canvas
            Margin="0,225,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <Line
                X1="0" Y1="0"
                X2="70" Y2="0"
                Stroke="Black"
                StrokeThickness="1"/>

            <Ellipse
                Width="10"
                Height="10"
                Canvas.Left="65"
                Canvas.Top="-5"
                Fill="Black"/>
        </Canvas>

        <!-- Formulário -->
        <StackPanel
            Width="400"
            Margin="0,125,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

            <!-- Título -->
            <TextBlock
                FontSize="57"
                Text="Cadastrar"/>

            <!-- Subtítulo -->
            <StackPanel
                Margin="0,-2,0,0"
                Orientation="Horizontal">

                <TextBlock
                    FontSize="20"
                    FontStyle="Italic"
                    Text="crie seu "/>

                <Border
                    Padding="4,0"
                    Background="#D8E9E5">

                    <TextBlock
                        FontSize="20"
                        FontStyle="Italic"
                        Text="acesso ao painel"/>
                </Border>
            </StackPanel>

            <!-- Descrição -->
            <TextBlock
                Margin="0,14,0,26"
                FontSize="14"
                FontStyle="Italic"
                Text="Cadastre um usuário para acessar o painel de verificação."
                TextWrapping="Wrap"/>

            <!-- Tipo de usuário -->
            <TextBlock
                Style="{StaticResource RotuloCampo}"
                Text="Tipo de Usuário"/>

            <ComboBox
                Height="52"
                Margin="0,0,0,14"
                Padding="12,8"
                FontFamily="Segoe UI"
                FontSize="15"
                Background="#FAF9F6"
                BorderBrush="Black"
                BorderThickness="1"
                ItemsSource="{Binding TiposUsuario}"
                SelectedItem="{Binding TipoUsuarioSelecionado, Mode=TwoWay}"/>

            <!-- Nome -->
            <TextBlock
                Style="{StaticResource RotuloCampo}"
                Text="Nome"/>

            <TextBox
                Style="{StaticResource CampoTexto}"
                Margin="0,0,0,14"
                Text="{Binding Nome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Nome de usuário -->
            <TextBlock
                Style="{StaticResource RotuloCampo}"
                Text="Nome de Usuário"/>

            <TextBox
                Style="{StaticResource CampoTexto}"
                Margin="0,0,0,14"
                Text="{Binding NomeUsuario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Senha -->
            <TextBlock
                Style="{StaticResource RotuloCampo}"
                Text="Senha"/>

            <PasswordBox
                Height="52"
                Margin="0,0,0,24"
                Padding="14,0"
                FontFamily="Segoe UI"
                FontSize="15"
                Background="#FAF9F6"
                BorderBrush="Black"
                BorderThickness="1"
                VerticalContentAlignment="Center"
                PasswordChanged="txtSenha_PasswordChanged"/>

            <!-- Botão cadastrar -->
            <Button
                Style="{StaticResource BotaoPreto}"
                Content="Cadastrar"
                Command="{Binding CommandCadastrar}"/>

            <!-- Botão voltar -->
            <Button
                Height="45"
                Margin="0,12,0,0"
                Background="Transparent"
                BorderBrush="Black"
                BorderThickness="1"
                Foreground="Black"
                FontFamily="Segoe UI"
                FontSize="15"
                Content="Voltar"
                Cursor="Hand"
                Command="{Binding CommandVoltar}"/>

        </StackPanel>

        <!-- Decoração inferior direita -->
        <Canvas
            Margin="0,0,0,45"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">

            <Line
                X1="0" Y1="0"
                X2="70" Y2="0"
                Stroke="Black"
                StrokeThickness="1"/>

            <Ellipse
                Width="10"
                Height="10"
                Canvas.Left="-5"
                Canvas.Top="-5"
                Fill="Black"/>
        </Canvas>

    </Grid>
</Window>
