<Window
    x:Class="InstaFakeAnalyzerClient.View.ViewInserirNoticia"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Inserir Nova Notícia"
    Width="800"
    Height="780"
    Background="#F4F0E7"
    FontFamily="Georgia"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Campos de texto -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="#FAF9F6"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Rótulos -->
        <Style x:Key="RotuloCampo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Botão principal -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão secundário -->
        <Style x:Key="BotaoSecundario" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E0D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid ClipToBounds="True">

        <!-- Marca do sistema -->
        <TextBlock
            Margin="35,22,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="26"
            FontWeight="Bold"
            Text="InstaFake Analyzer"/>

        <!-- Decoração lateral -->
        <Canvas
            Margin="0,195,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <Line
                X1="0"
                Y1="0"
                X2="70"
                Y2="0"
                Stroke="Black"
                StrokeThickness="1"/>

            <Ellipse
                Width="10"
                Height="10"
                Canvas.Left="65"
                Canvas.Top="-5"
                Fill="Black"/>
        </Canvas>

        <!-- Conteúdo principal -->
        <Grid
            Width="650"
            Margin="0,105,0,65"
            HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock
                Grid.Row="0"
                FontSize="49"
                Text="Nova Notícia"/>

            <!-- Subtítulo -->
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,8"
                Orientation="Horizontal">

                <TextBlock
                    FontSize="20"
                    FontStyle="Italic"
                    Text="adicione uma "/>

                <Border
                    Padding="4,0"
                    Background="#D8E9E5">

                    <TextBlock
                        FontSize="20"
                        FontStyle="Italic"
                        Text="notícia ao sistema"/>
                </Border>
            </StackPanel>

            <!-- Descrição -->
            <TextBlock
                Grid.Row="2"
                Margin="0,8,0,20"
                FontSize="14"
                FontStyle="Italic"
                Foreground="#333333"
                Text="Preencha os campos abaixo para registrar uma nova notícia."
                TextWrapping="Wrap"/>

            <!-- Conteúdo da notícia -->
            <Grid Grid.Row="3" Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource RotuloCampo}"
                    Text="Conteúdo da Notícia"/>

                <TextBox
                    Grid.Row="1"
                    Style="{StaticResource CampoTexto}"
                    Text="{Binding Conteudo, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Justificativa -->
            <Grid Grid.Row="5" Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource RotuloCampo}"
                    Text="Justificativa"/>

                <TextBox
                    Grid.Row="1"
                    Style="{StaticResource CampoTexto}"
                    Text="{Binding Justificativa, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Classificação -->
            <CheckBox
                Grid.Row="6"
                Margin="0,5,0,20"
                VerticalAlignment="Center"
                FontFamily="Segoe UI"
                FontSize="15"
                Foreground="#222222"
                Content="Esta notícia é Fake News?"
                IsChecked="{Binding IsFake}"/>

            <!-- Botões -->
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Style="{StaticResource BotaoSecundario}"
                    Command="{Binding VoltarCommand}"
                    Content="Voltar"/>

                <Button
                    Grid.Column="2"
                    Style="{StaticResource BotaoPrincipal}"
                    Command="{Binding SalvarCommand}"
                    Content="Salvar Notícia"/>
            </Grid>

        </Grid>

        <!-- Decoração inferior -->
        <Canvas
            Margin="0,0,0,35"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">

            <Line
                X1="0"
                Y1="0"
                X2="70"
                Y2="0"
                Stroke="Black"
                StrokeThickness="1"/>

            <Ellipse
                Width="10"
                Height="10"
                Canvas.Left="-5"
                Canvas.Top="-5"
                Fill="Black"/>
        </Canvas>

    </Grid>
</Window>
