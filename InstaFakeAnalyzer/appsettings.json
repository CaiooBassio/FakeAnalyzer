{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=fakenews.db"
  },
  "AI": {
    "Provider": "Gemini",
    "FallbackProviders": [
      "DeepSeek"
    ],
    "Research": {
      "BaseUrl": "https://api.search.brave.com/res/v1",
      "Country": "BR",
      "Language": "pt-br"
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
