    },
    "DeepSeek": {
      "BaseUrl": "https://openrouter.ai/api/v1",
      "Model": "deepseek/deepseek-v4.1-flash"
    }
  },
  "Urls": {
    "ApiUrl": "http://localhost:5170/api/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}